#!/usr/bin/env python3
"""管理画面の「今すぐ解除」ボタン(security_events.unban_requested_at)を、
ホスト側で実際に`fail2ban-client unbanip`するcron(1分毎・2026-09-29)。

コンテナ(アプリ)からホストのfail2banを直接操作する経路は作らず、
「アプリが解除依頼を記録する→ホストのcronが1分以内に見つけて処理する→
結果を報告する」という非同期のポーリングにしている(安全側。万一アプリが
乗っ取られても、ホストのコマンドを直接実行される経路にはならない)。
多重起動はcron.d側の`flock -n`で防ぐ(このスクリプト自体は多重起動されても
`fail2ban-client set ... unbanip`が冪等なため実害はない)。

使い方: eigo-f2b-unban-poller (引数なし・/etc/cron.d/eigo-f2bから呼ばれる)
"""
import ipaddress
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

CONF = os.environ.get("EIGO_F2B_CONF", "/etc/eigo-f2b.conf")  # 環境変数はテスト用
AUDIT = os.environ.get("EIGO_F2B_AUDIT", "/var/log/eigo-f2b-audit.log")
# eigo-f2b-audit(app/routers/system.pyの_KNOWN_JAILS)と同じ一覧。アプリ側の
# 応答を信用しきらず、実際にホストコマンドを叩く直前でも検証する
# (2026-09-29 Fable指摘H1: 相乗りの他jail(sshd等)を操作するレバーに
# ならないように・多重防御)。
_KNOWN_JAILS = {"eigo-probe", "eigo-loginflood", "eigo-loginfail", "eigo-ratelimited"}


def conf_value(key):
    try:
        with open(CONF, encoding="utf-8") as f:
            for line in f:
                if line.startswith(key + "="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return ""


def audit(msg):
    try:
        with open(AUDIT, "a", encoding="utf-8") as fh:
            fh.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg))
    except OSError:
        pass


def api(method, path, token, url):
    req = urllib.request.Request(
        url.rstrip("/") + path, headers={"X-F2B-Token": token}, method=method)
    return urllib.request.urlopen(req, timeout=5).read()


def _valid_ip(ip):
    try:
        ipaddress.ip_address(ip)
        return True
    except ValueError:
        return False


def process_one(item, token, url):
    """1件処理する。例外を外へ出さない(1件の失敗が他の行の処理を止めない)。"""
    eid, ip, jail = item.get("id"), item.get("ip", ""), item.get("jail", "")
    if not isinstance(eid, int) or not _valid_ip(ip) or jail not in _KNOWN_JAILS:
        audit("UNBAN-REQUEST-INVALID id=%r ip=%r jail=%r" % (eid, ip, jail))
        return
    try:
        r = subprocess.run(
            ["fail2ban-client", "set", jail, "unbanip", ip],
            capture_output=True, text=True, timeout=15)
        ok = r.returncode == 0
        detail = "" if ok else (r.stderr or r.stdout or "")[:200].replace("\n", " ")
    except (OSError, subprocess.SubprocessError) as e:
        # fail2ban-clientが無い・タイムアウト等(2026-09-29 Fable指摘M2:
        # 以前はここで未捕捉の例外になり、以降の行の処理が止まっていた)。
        ok, detail = False, str(e)[:200]
    audit("UNBAN-REQUEST %s ip=%s jail=%s ok=%s%s" % (
        eid, ip, jail, ok, (" detail=%s" % detail) if detail else ""))
    if not ok:
        return  # 次回のポーリングでまた対象になる(fail2ban-client側が直れば成功する)
    try:
        api("POST", "/api/system/security-events/%s/unban-done" % eid, token, url)
    except (urllib.error.URLError, OSError) as e:
        audit("UNBAN-POLL-FAILED report id=%s err=%s" % (eid, e))


def main():
    token = conf_value("NOTIFY_TOKEN")
    url = conf_value("APP_URL")
    if not token or not url:
        return 0  # 未設定(通知機能自体が無効)なら何もしない
    try:
        raw = api("GET", "/api/system/security-events/pending-unbans", token, url)
        pending = json.loads(raw).get("pending", [])
    except (urllib.error.URLError, ValueError, OSError) as e:
        audit("UNBAN-POLL-FAILED fetch err=%s" % e)
        return 1
    for item in pending:
        process_one(item, token, url)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # pragma: no cover - 想定外でもcronを静かに落とさない
        audit("UNBAN-POLL-CRASHED err=%s" % e)
        sys.exit(1)
