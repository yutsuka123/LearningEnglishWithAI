#!/usr/bin/env python3
"""fail2banのアクション(eigo-audit)から呼ばれ、判定の根拠を監査ログに残す。

使い方: eigo-f2b-audit <ban|unban|start|stop> <jail> <ip> <failures> <bantime> <mode>
- mode=dryrun: 実際にはBANしていない(「BANしたはず」の記録)。mode=ban: 実際にBANした。
- BAN時は、そのIPの直近のリクエスト(時刻・メソッド・URI・status・UA)を最大6件、根拠として添える。
  ヘッダー全体(Cookie等)は出力しない。UAは60字まで。URIのクエリ(gclid等)は落とす。
出力先: /var/log/eigo-f2b-audit.log(root:adm 640・logrotateで8世代)。
2026-09-29〜: ban/unban時はアプリの内部API(POST /api/system/security-events)にも通知し、
管理画面の「アクセス制限」一覧に出す(オーナー要望)。通知はbest-effort
(アプリが落ちていてもfail2ban本体のBAN動作は止めない・監査ログへの記録は独立して必ず行う)。
"""
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request

CONF = os.environ.get("EIGO_F2B_CONF", "/etc/eigo-f2b.conf")  # 環境変数はテスト用
AUDIT = os.environ.get("EIGO_F2B_AUDIT", "/var/log/eigo-f2b-audit.log")
TAIL_BYTES = 24 * 1024 * 1024


def conf_value(key):
    try:
        with open(CONF, encoding="utf-8") as f:
            for line in f:
                if line.startswith(key + "="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return ""


def logdir():
    return conf_value("CADDY_LOG_DIR")


def notify(jail, ip, action, mode, failures, bantime, evidence_lines):
    """アプリへPOST(best-effort・2〜3秒でタイムアウト・失敗は監査ログにだけ残す)。"""
    token = conf_value("NOTIFY_TOKEN")
    url = conf_value("APP_URL")
    if not token or not url:
        return
    payload = json.dumps({
        "ip": ip, "jail": jail, "action": action, "mode": mode,
        "failures": int(failures) if str(failures).isdigit() else 0,
        "bantime_seconds": int(bantime) if str(bantime).isdigit() else 0,
        "evidence": "\n".join(evidence_lines),
    }).encode("utf-8")
    req = urllib.request.Request(
        url.rstrip("/") + "/api/system/security-events", data=payload,
        headers={"Content-Type": "application/json", "X-F2B-Token": token},
        method="POST")
    try:
        urllib.request.urlopen(req, timeout=3).read()
    except (urllib.error.URLError, OSError) as e:
        try:
            with open(AUDIT, "a", encoding="utf-8") as fh:
                fh.write("%s NOTIFY-FAILED %s ip=%s err=%s\n" % (
                    time.strftime("%Y-%m-%d %H:%M:%S"), jail, ip, e))
        except OSError:
            pass


SUSPECT = re.compile(
    r"(wp-login|wp-admin|wp-content|xmlrpc|/\.env|/\.git/|phpmyadmin|phpinfo|cgi-bin|/vendor/|actuator|"
    r"/etc/passwd|boaform|HNAP1|manager/html|\.php|\.asp|\.jsp|^/login)", re.I)


def evidence(ip):
    """そのIPの直近のリクエストのうち、不審なもの(4xx・探索URL・/login)を優先して最大6件(時刻順)。"""
    path = os.path.join(logdir(), "study.log")
    rows = []  # (ts, 表示文字列, 不審か)
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as fh:
            fh.seek(max(0, size - TAIL_BYTES))
            data = fh.read().decode("utf-8", errors="replace")
        for line in data.splitlines():
            if ip not in line:
                continue
            try:
                r = json.loads(line)
            except ValueError:
                continue
            req = r.get("request", {})
            if req.get("remote_ip") != ip:
                continue
            ua = (req.get("headers", {}).get("User-Agent") or [""])[0][:60]
            uri = req.get("uri", "").split("?")[0][:80]
            status = r.get("status", 0)
            ts = r.get("ts", 0)
            text = '%s %s %s %s "%s"' % (
                time.strftime("%H:%M:%S", time.localtime(ts)), req.get("method", "?"), uri, status, ua)
            rows.append((ts, text, status in (401, 403, 404, 429) or bool(SUSPECT.search(uri))))
    except Exception:  # 想定外の行・読み込み失敗でも、BANの実行(アクション)自体は止めない
        return ["(ログを読めませんでした)"]
    suspects = [r for r in rows if r[2]][-4:]
    latest = [r for r in rows[-2:] if r not in suspects]
    return [r[1] for r in sorted(suspects + latest)]


def main():
    action, jail, ip, failures, bantime, mode = (sys.argv[1:7] + [""] * 6)[:6]
    now = time.strftime("%Y-%m-%d %H:%M:%S")
    tag = "DRYRUN" if mode == "dryrun" else "BAN-ON"
    lines = []
    evid = []
    if action == "ban":
        evid = evidence(ip)
        lines.append("%s %-6s BAN    %s ip=%s failures=%s bantime=%ss" % (now, tag, jail, ip, failures, bantime))
        lines += ["    根拠: " + e for e in evid]
    elif action == "unban":
        lines.append("%s %-6s UNBAN  %s ip=%s" % (now, tag, jail, ip))
    else:
        lines.append("%s %-6s %s %s" % (now, tag, action.upper(), jail))
    try:
        with open(AUDIT, "a", encoding="utf-8") as fh:
            fh.write("\n".join(lines) + "\n")
    except OSError as e:
        print("audit log write failed: %s" % e, file=sys.stderr)
    if action in ("ban", "unban"):
        notify(jail, ip, action, mode, failures, bantime, evid)
    return 0


if __name__ == "__main__":
    sys.exit(main())
