#!/usr/bin/env python3
"""fail2banのignorecommand: 引数のIPを「対象外(無視)」にするなら終了コード0、そうでなければ1。

通常モード(`eigo-f2b-ignore <ip>`): 次のIPを対象外=BANしない(終了コード0):
  1. /etc/fail2ban/eigo-allowlist.txt (運営者が手で書く・IP or CIDR・#コメント可)
  2. /var/lib/eigo-f2b/trusted.txt (アカウント作成から2日以上経ったユーザーが直近30日にログイン成功したIP・
     eigo-f2b-trusted-refreshが10分ごとにDBから更新)。
  → 全てのjail(eigo-probe含む。2026-10-04〜)がこのモード。信頼IPは探索でもBANしない(運営者や自動テストが
    うっかり探索パスに触れても自分のIPが12時間BANされないように・2026-10-04オーナー決定)。

記録専用モード(`eigo-f2b-ignore --only-exempt <ip>`・2026-10-04〜): **上の逆**。許可リスト/信頼IPに**当たるIPだけ**を
数える(終了コード1=無視しない)。当たらないIPは無視する(終了コード0)。eigo-probe-trustedジェイル専用で、
「BANはしないが、信頼IP/許可リストのIPが探索パスを叩いたことは記録に残す」ために使う(信頼IPのふりをした
なりすまし・同じ回線の第三者・端末の乗っ取り等を後から気づけるように)。実際のBANは行わない(dryrunのアクションのみ)。

`--allow-only`(許可リストだけを見る・旧eigo-probe用)は互換のために残してあるが、現在は使っていない。
スクリプト内の判定に失敗した場合(ファイルが読めない等)は「無視する(終了コード0)=BANも記録もしない」側に倒す。
ただしpython3が無い/実行権限が無い等でスクリプト自体が起動できない場合、fail2banは「無視しない」扱いになる
(install.shがpython3と実行権限を保証する)。
実ユーザー・運営者・テストを誤ってBANしないための安全弁(2026-09-26)。
"""
import ipaddress
import os
import sys

ALLOW = os.environ.get("EIGO_F2B_ALLOW", "/etc/fail2ban/eigo-allowlist.txt")  # 環境変数はテスト用
TRUSTED = os.environ.get("EIGO_F2B_TRUSTED", "/var/lib/eigo-f2b/trusted.txt")


def load(path):
    out = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if line:
                    out.append(line)
    except FileNotFoundError:
        pass
    return out


def is_exempt(ip, allow_only=False):
    """許可リスト(+信頼IP)に当たるか。許可リストはIP/CIDR(運営者が手で書く)。信頼IPは**単一アドレスの完全一致のみ**
    (自動生成のファイルに「0.0.0.0/0」のような広い範囲が紛れても全員を免除しないため・2026-10-04独立照査L8)。"""
    for entry in load(ALLOW):
        try:
            if ip in ipaddress.ip_network(entry, strict=False):
                return True
        except ValueError:
            continue
    if not allow_only:
        for entry in load(TRUSTED):
            try:
                if ip == ipaddress.ip_address(entry):
                    return True
            except ValueError:
                continue
    return False


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    allow_only = "--allow-only" in sys.argv[1:]
    only_exempt = "--only-exempt" in sys.argv[1:]
    try:
        ip = ipaddress.ip_address(args[0])
    except Exception:
        return 0  # 解釈できないIPはBANも記録もしない
    exempt = is_exempt(ip, allow_only)
    if only_exempt:
        # 記録専用: 免除されるIPだけを数える(=無視しない=1)。それ以外は無視(=0)。
        return 1 if exempt else 0
    return 0 if exempt else 1


def _note_error(e):
    """想定外の失敗を監査ログへ1行残す(best-effort)。失敗時は無視(=BANも記録もしない)側に倒すので、
    eigo-probe等が黙って働かなくなったことに後から気づけるように(2026-10-04独立照査L8)。"""
    try:
        with open(os.environ.get("EIGO_F2B_AUDIT", "/var/log/eigo-f2b-audit.log"), "a", encoding="utf-8") as fh:
            fh.write("%s IGNORE-CMD-ERROR %s\n" % (__import__("time").strftime("%Y-%m-%d %H:%M:%S"), type(e).__name__))
    except Exception:
        pass


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        _note_error(e)
        sys.exit(0)  # 想定外の失敗はBANしない側に倒す
