#!/usr/bin/env python3
"""fail2banのignorecommand: 引数のIPを「BANの対象外」にするなら終了コード0、そうでなければ1。

対象外にするIP:
  1. /etc/fail2ban/eigo-allowlist.txt (運営者が手で書く・IP or CIDR・#コメント可)
  2. /var/lib/eigo-f2b/trusted.txt (直近30日にログイン成功したIP・eigo-f2b-trusted-refreshが10分ごとに更新)
実ユーザー・運営者・テストを誤ってBANしないための安全弁(2026-09-26)。
判定に失敗した場合(ファイルが読めない等)は「対象外にする=BANしない」側に倒す。
"""
import ipaddress
import os
import sys

ALLOW = os.environ.get("EIGO_F2B_ALLOW", "/etc/fail2ban/eigo-allowlist.txt")  # 環境変数はテスト用
TRUSTED = os.environ.get("EIGO_F2B_TRUSTED", "/var/lib/eigo-f2b/trusted.txt")


def load(path):
    out = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if line:
                    out.append(line)
    except FileNotFoundError:
        pass
    return out


def main():
    try:
        ip = ipaddress.ip_address(sys.argv[1])
    except Exception:
        return 0  # 解釈できないIPはBANしない
    for entry in load(ALLOW) + load(TRUSTED):
        try:
            if ip in ipaddress.ip_network(entry, strict=False):
                return 0
        except ValueError:
            continue
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)  # 想定外の失敗はBANしない側に倒す
