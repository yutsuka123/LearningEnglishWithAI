# Copy this file to ".env" and fill in your values.
# The app starts and runs locally even without an API key —
# only the AI-powered features require it.

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Model used for教材生成・添削・対話 (2026-08-08: gpt-5.6-lunaへ変更。
# gpt-5.4-mini比でコスト65-73%減・会話品質は同等を確認。ただし構造化JSON
# 出力(単語/フレーズ詳細生成等)でキー名不一致・原語混入の品質問題あり)
OPENAI_MODEL=gpt-5.6-luna
# 品質重視の処理(判定/詳細生成など)。未設定なら OPENAI_MODEL を使用。
# 上記の理由により、構造化JSON生成の品質問題を避けるため明示的に
# gpt-5.4-miniを指定することを推奨。
OPENAI_QUALITY_MODEL=gpt-5.4-mini

# Natural TTS model for読み上げ (default: gpt-4o-mini-tts)
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Your nickname (how the AI addresses you). Personal info lives ONLY here
# in .env — never in git-tracked files. Leave blank to stay anonymous.
USER_NICKNAME=

# Server host / port
HOST=127.0.0.1
PORT=8000

# USD→JPY 為替レート（費用の円換算用）。週1回見直し推奨。
USD_JPY_RATE=155
USD_JPY_AS_OF=2026-06-14

# --- AI コスト暴走ガード（不意の高額課金を防止）-----------------------------
# 1日(ローカル日)の合計AI費用の上限(USD)。超過で全AI呼び出しを停止。0で無効。
AI_DAILY_COST_CAP_USD=1.0
# 1分あたりのAI呼び出し回数の上限（ループ等の暴走を遮断）。
AI_MAX_CALLS_PER_MIN=20
# chat の max_tokens 上限（過大指定をクランプ）。
AI_MAX_OUTPUT_TOKENS=1500
# 枠外利用時にチャージ残高から控除する倍率（原価×為替×この値）。
# 2026-08-08: 1.5→2.0に変更（粗利率33%→50%）。docs/COST_ESTIMATE.md §6参照。
BALANCE_MARKUP=2.0

# --- 音声(MP3)の保存方式 -----------------------------------------------------
# file = data/audio に番号＋声で保存 / db = DBにBLOB / hybrid = 両方。
AUDIO_STORAGE=file

# Data directory (optional). Defaults to ./data next to the app.
# DATA_DIR=

# --- マルチユーザー（§A・限定公開/VPS用）-----------------------------------
# 1 でログイン必須のマルチユーザーモード。0/未設定はローカル単一ユーザー
# （owner として無認証で動く＝従来どおり）。ユーザーは scripts/admin.py で作成。
MULTIUSER=0
# セッションCookieの署名鍵（任意・本番は固定推奨）。未設定なら DB に自動生成保存。
# SESSION_SECRET=
# Secure Cookie: auto(既定=HTTPSなら付与) / 1(常に) / 0(付けない)。本番は 1 か auto。
# COOKIE_SECURE=auto
# 汎用 IP レート制限（リクエスト/分）。0=無効(既定・ローカル)。公開時は 300 程度を推奨。
# 真のDDoSは前段(Cloudflare/Caddy/fail2ban)で防ぐ。これは速度制限の補助。
RATE_LIMIT_PER_MIN=0

# --- 特定商取引法に基づく表記（/tokushoho ページ）--------------------------
# 個人情報のためここ(.env)にのみ記載する。空欄のままだと該当欄に
# 「[要記入]」の案内文が表示される。埋めると自動でページに反映される
# （コードの変更・再デプロイは不要。サーバー再起動のみで反映）。
# 住所・電話番号は特定商取引法の2022年改正により、個人事業主は
# 「請求があれば遅滞なく開示します」という文言で開示を省略できる場合が
# あります（詳細は利用する決済窓口のガイドラインで確認）。省略する場合は
# その文言をそのまま値として入力してください。
# TOKUSHOHO_NAME=
# TOKUSHOHO_SUPERVISOR=
# TOKUSHOHO_ADDRESS=
# TOKUSHOHO_PHONE=
# TOKUSHOHO_EMAIL=

# --- チャージキー（BASE等での手売り招待コード・§商用化）--------------------
# キーのユニークID部分(連番->一見ランダムな値への変換)に使う秘密鍵。
# 本番投入前に必ず固定値を設定すること。未設定だと開発用の既定値で動くため
# 予測可能になる。一度本番で使い始めたら値を変更しない（既発行キーとの
# 対応が変わってしまうため）。
# CHARGE_KEY_SECRET=
# ログイン保護(実装済・固定): 3回連続失敗→5分ロック / 1IPから15回失敗/5分→15分ロック。

# --- BASE API連携（注文自動検知・§フルフィルメントPhase B）------------------
# developers.thebase.com でOAuth2アプリ登録後に発行されるClient ID/Secret。
# 初回連携は管理画面(フルフィルメント管理)の「BASEと連携する」から行う
# （access_token/refresh_tokenはDBのbase_api_tokensに保存されるため.envには
# 書かない）。
# BASE_CLIENT_ID=
# BASE_CLIENT_SECRET=

# --- 注文通知メール（§フルフィルメントPhase C・2026-08-25）------------------
# 新規注文検知・未配送リマインドをGmail SMTP経由で送るための送信元アカウント。
# Googleアカウントの「アプリパスワード」を発行して設定する（通常のログイン
# パスワードは不可）。未設定の間は通知をスキップするだけで同期自体は動く。
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
# 通知の送り先（未設定ならGMAIL_ADDRESS宛に自己送信）。
# FULFILLMENT_NOTIFY_EMAIL=

# --- 管理者自身の既知IP（管理画面の分析用・任意）-----------------------------
# 管理画面「未登録アクセス状況」「IP別アクセス」で、自分自身のアクセスに
# 「※1」の印を付けて実訪問者と区別するためのカンマ区切りリスト。
# 自宅回線・モバイル回線など、自分がアクセスしうるIPを列挙する（動的IPで
# 変わったら追記する）。**実IPは個人情報なのでこのexampleには書かず、
# gitignore対象の .env / deploy/.env.study にのみ書くこと。**
# ADMIN_KNOWN_IPS=203.0.113.10,198.51.100.20
